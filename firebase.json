{
  "functions": [
    {
      "source": "functions",
      "codebase": "commerce"
    },
    {
      "source": "functions-ict-commerce",
      "codebase": "ict-commerce",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix functions-ict-commerce run check"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "functions-ict-commerce/**",
      "scripts/**",
      "docs/**",
      "**/*.log",
      "**/*.rules",
      "firestore.indexes.json",
      "package.json",
      "tests/**",
      "ECOMMERCE_SETUP.md",
      "CNAME",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      ".github/**",
      "security-workers/**",
      "cms/**"
    ],
    "predeploy": [
      "node scripts/build-rss.cjs"
    ],
    "rewrites": [
      {
        "source": "/api/ispSuiteApi",
        "function": {
          "functionId": "ispSuiteApi",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/ispCustomerRequest",
        "function": {
          "functionId": "ispCustomerRequest",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/adminIspOperations",
        "function": {
          "functionId": "adminIspOperations",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityMonitoringControls",
        "function": {
          "functionId": "securityMonitoringControls",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityMonitoringResults",
        "function": {
          "functionId": "securityMonitoringResults",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityMonitoringStatus",
        "function": {
          "functionId": "securityMonitoringStatus",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityMonitoringWebhook",
        "function": {
          "functionId": "securityMonitoringWebhook",
