{
  "functions": [
    {
      "source": "functions",
      "codebase": "commerce"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "docs/**",
      "**/*.log",
      "**/*.rules",
      "ECOMMERCE_SETUP.md",
      "CNAME",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      ".github/**",
      "security-workers/**"
    ],
    "predeploy": [
      "node scripts/build-rss.cjs"
    ],
    "rewrites": [
      {
        "source": "/api/securityGithubWebhook",
        "function": {
          "functionId": "securityGithubWebhook",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security-github",
        "function": {
          "functionId": "securityGithubApp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security-github/**",
        "function": {
          "functionId": "securityGithubApp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/securityPaystackWebhook",
        "function": {
          "functionId": "securityPaystackWebhook",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/securityPaystackCheckout",
        "function": {
          "functionId": "securityPaystackCheckout",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security-commerce/**",
        "function": {
          "functionId": "securityCommerce",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security-commerce",
        "function": {
          "functionId": "securityCommerce",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security/**",
        "function": {
          "functionId": "securityApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/security",
        "function": {
          "functionId": "securityApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/siteAssistant",
        "function": {
          "functionId": "siteAssistant",
          "region": "europe-west1"
        }
      }
    ]
  }
}
