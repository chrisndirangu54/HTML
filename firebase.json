{
  "functions": [
    {
      "source": "functions",
      "codebase": "commerce"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "docs/**",
      "**/*.log",
      "**/*.rules",
      "ECOMMERCE_SETUP.md",
      "CNAME",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      ".github/**"
    ],
    "predeploy": [
      "node scripts/build-rss.cjs"
    ]
  }
}
