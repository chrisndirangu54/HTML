{
  "functions": [
    {
      "source": "functions",
      "codebase": "commerce"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/securityGithubWebhook",
        "function": {
          "functionId": "securityGithubWebhook",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security-github",
        "function": {
          "functionId": "securityGithubApp",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security-github/**",
        "function": {
          "functionId": "securityGithubApp",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityPaystackWebhook",
        "function": {
          "functionId": "securityPaystackWebhook",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/securityPaystackCheckout",
        "function": {
          "functionId": "securityPaystackCheckout",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security-commerce/**",
        "function": {
          "functionId": "securityCommerce",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security-commerce",
        "function": {
          "functionId": "securityCommerce",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security/**",
        "function": {
          "functionId": "securityApi",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/security",
        "function": {
          "functionId": "securityApi",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      },
      {
        "source": "/api/siteAssistant",
        "function": {
          "functionId": "siteAssistant",
          "region": "europe-west1",
          "codebase": "commerce"
        }
      }
    ]
  }
}
