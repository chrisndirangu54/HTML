# Non-secret runtime settings. Configure with your deployment environment.
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
PAYSTACK_CALLBACK_URL=https://tekntandao.com/#Shop

# Secrets must NOT be committed. Set them with Firebase Functions secrets:
# firebase functions:secrets:set PAYSTACK_SECRET_KEY
# firebase functions:secrets:set MPESA_CONSUMER_KEY
# firebase functions:secrets:set MPESA_CONSUMER_SECRET
# firebase functions:secrets:set MPESA_SHORTCODE
# firebase functions:secrets:set MPESA_PASSKEY
# firebase functions:secrets:set MPESA_CALLBACK_URL
# firebase functions:secrets:set MPESA_CALLBACK_TOKEN
